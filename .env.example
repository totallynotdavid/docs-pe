# Providers to run, in order, with an optional per-provider lane count after a
# colon. Omit the count to use that provider's own tuned default. Lanes are
# spawned PER PROVIDER, so "geonode:30,dataimpulse:18" runs 48 lanes in total.
PROXY_PROVIDER=geonode:30,dataimpulse:18  # [geonode, dataimpulse]

# GeoNode usernames are generated from these values for each worker session.
GEONODE_USERNAME=
GEONODE_PASSWORD=
# Gateway values: fr, fr_whitelist, us, sg
GEONODE_GATEWAY=fr
GEONODE_PROXY_TYPE=residential  # [residential, datacenter, mix]
# Required: OSIPTEL's WAF blocks foreign exits, so target Peru.
GEONODE_COUNTRY=PE
GEONODE_LIFETIME_MINUTES=10

DATAIMPULSE_USERNAME=
DATAIMPULSE_PASSWORD=
DATAIMPULSE_COUNTRY=pe
# Sticky session lifetime in minutes (>= 1). One lookup runs well under a
# minute, so a small value is fine.
DATAIMPULSE_SESSION_MINUTES=3

# Local portal development. `mise run portal:dev` provisions this administrator and
# the first team idempotently after applying migrations.
PORTAL_DATABASE_DSN=postgresql://postgres@127.0.0.1:5432/postgres
PORTAL_ENVIRONMENT=development
PORTAL_PUBLIC_ORIGIN=http://localhost:8000
PORTAL_COOKIE_SECURE=false
# Required in every environment: urlsafe base64 of 32 bytes.
PORTAL_SECRET_PROTECTION_KEY=
PORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=
PORTAL_BOOTSTRAP_TEAM_NAME="Equipo Lima"
PORTAL_BOOTSTRAP_TEAM_SLUG=equipo-lima
