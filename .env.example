# One name runs one provider. A comma-separated list runs several providers
# side by side against one shared queue. Every listed provider must have its
# credential block filled in below.
PROXY_PROVIDER=geonode  # [geonode, dataimpulse, or geonode,dataimpulse]

# GeoNode usernames are generated from these values for each worker session.
GEONODE_USER=
GEONODE_PASS=
# Gateway values: fr, fr_whitelist, us, sg
GEONODE_GATEWAY=fr
GEONODE_TYPE=residential  # [residential, datacenter, mix]
# Required: OSIPTEL's WAF blocks foreign exits, so target Peru.
GEONODE_COUNTRY=PE
GEONODE_LIFETIME=10

DATAIMPULSE_USER=
DATAIMPULSE_PASS=
DATAIMPULSE_COUNTRY=pe
# Sticky session lifetime in minutes (>= 1). One lookup runs well under a
# minute, so a small value is fine.
DATAIMPULSE_SESSTTL=3
