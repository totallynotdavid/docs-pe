# Ordered providers with optional lane counts. Counts apply per provider, so
# geonode:30,dataimpulse:18 creates 48 lanes.
PROXY_PROVIDER=geonode:30,dataimpulse:18  # [geonode, dataimpulse]

GEONODE_USERNAME=
GEONODE_PASSWORD=
GEONODE_GATEWAY=fr  # [fr, fr_whitelist, us, sg]
GEONODE_PROXY_TYPE=residential  # [residential, datacenter, mix]
# OSIPTEL blocks non-Peru exits.
GEONODE_COUNTRY=PE
GEONODE_LIFETIME_MINUTES=10

DATAIMPULSE_USERNAME=
DATAIMPULSE_PASSWORD=
DATAIMPULSE_COUNTRY=pe
DATAIMPULSE_SESSION_MINUTES=3  # >= 1

PORTAL_DATABASE_DSN=postgresql://postgres@127.0.0.1:5432/postgres
PORTAL_ENVIRONMENT=development  # [development, production]
# HTTPS, Secure cookies, and host checking follow this origin, not the
# environment. Only development may declare an http origin.
PORTAL_PUBLIC_ORIGIN=http://localhost:8000
PORTAL_TLS_TERMINATED_UPSTREAM=false

# Wraps the data key on every stored credential and TOTP secret. One key per
# line, `<version> <urlsafe-base64 32 bytes>`, newest first.
# Write one with: uv run portal new-key --version v1 >> .data/master.key
PORTAL_MASTER_KEY_FILE=.data/master.key

# Turnstile on /login, verified server-side. Required in production.
PORTAL_TURNSTILE_SITE_KEY=
PORTAL_TURNSTILE_SECRET=

# Where portal worker-api listens. In a container this is the container's own
# interface and the host publishes it on the tailnet address; outside one, set
# it to the tailscale0 address.
PORTAL_WORKER_API_HOST=127.0.0.1
PORTAL_WORKER_API_PORT=8443

PORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=
PORTAL_BOOTSTRAP_TEAM_NAME="Equipo Lima"
PORTAL_BOOTSTRAP_TEAM_SLUG=equipo-lima

# Set on a worker node. Issue the credential with `portal enroll-worker`.
PORTAL_WORKER_API_URL=
PORTAL_WORKER_CREDENTIAL=
PORTAL_WORKER_ID=poseidon-1

# Initial credentials read by `portal provision`.
PORTAL_PROVISION_ADMIN_PASSWORD=
PORTAL_PROVISION_GEONODE_USERNAME=
PORTAL_PROVISION_GEONODE_PASSWORD=
PORTAL_PROVISION_GEONODE_GATEWAY=fr
PORTAL_PROVISION_GEONODE_PROXY_TYPE=residential
PORTAL_PROVISION_GEONODE_COUNTRY=PE
PORTAL_PROVISION_GEONODE_LIFETIME_MINUTES=10
PORTAL_PROVISION_DATAIMPULSE_USERNAME=
PORTAL_PROVISION_DATAIMPULSE_PASSWORD=
PORTAL_PROVISION_DATAIMPULSE_COUNTRY=pe
PORTAL_PROVISION_DATAIMPULSE_SESSION_MINUTES=3
