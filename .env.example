PROXY_PROVIDER=geonode  # [geonode, dataimpulse]

# GeoNode
# Proxy usernames are generated from these values for each worker session.
GEONODE_USER=
GEONODE_PASS=
# Gateway values: fr, fr_whitelist, us, sg
GEONODE_GATEWAY=fr
GEONODE_TYPE=residential  # [residential, datacenter, mix]
GEONODE_COUNTRY=
GEONODE_LIFETIME=10

###########################################################################

# DataImpulse
DATAIMPULSE_USER=
DATAIMPULSE_PASS=
DATAIMPULSE_COUNTRY=pe
# Sticky session lifetime in minutes (>= 1). One lookup runs well under a
# minute, so a small value is fine.
DATAIMPULSE_SESSTTL=3
