# PostgreSQL is the only portal control plane and queue.
PORTAL_DATABASE_DSN=postgresql://postgres:postgres@127.0.0.1:5432/osiptel_portal
PORTAL_ENVIRONMENT=production
PORTAL_PUBLIC_ORIGIN=https://portal.example.org
PORTAL_COOKIE_SECURE=true
# Set both only for the first deployment; do not commit real values.
PORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-secret
