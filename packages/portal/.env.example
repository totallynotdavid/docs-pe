# PostgreSQL is the only portal control plane and queue.
PORTAL_DATABASE_DSN=postgresql://postgres:postgres@127.0.0.1:5432/portal
PORTAL_ENVIRONMENT=development
PORTAL_PUBLIC_ORIGIN=http://localhost:8000
PORTAL_COOKIE_SECURE=false
# Local-only 32-byte URL-safe base64 key. Generate one with the command in readme.md.
PORTAL_SECRET_PROTECTION_KEY=

# Provisioning reads only process environment values; `uv run --env-file` loads this
# file before executing the command. Never put a password in a CLI argument.
PORTAL_PROVISION_ADMIN_PASSWORD=
PORTAL_PROVISION_GEONODE_USERNAME=
PORTAL_PROVISION_GEONODE_PASSWORD=
PORTAL_PROVISION_GEONODE_GATEWAY=fr
PORTAL_PROVISION_GEONODE_TYPE=residential
PORTAL_PROVISION_GEONODE_COUNTRY=PE
PORTAL_PROVISION_GEONODE_LIFETIME_MINUTES=10
PORTAL_PROVISION_DATAIMPULSE_USERNAME=
PORTAL_PROVISION_DATAIMPULSE_PASSWORD=
PORTAL_PROVISION_DATAIMPULSE_COUNTRY=pe
PORTAL_PROVISION_DATAIMPULSE_SESSION_MINUTES=3
