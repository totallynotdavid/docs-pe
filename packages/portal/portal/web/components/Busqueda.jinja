{#def accion, consulta="" #}
<form {{ attrs.render(class="busqueda", method="get", action=accion) }}>
  <label for="consulta">Número de documento</label>
  <input id="consulta"
         name="q"
         value="{{ consulta }}"
         autocomplete="off"
         placeholder="Ej. 10412345678">
  <button type="submit">Buscar</button>
</form>
