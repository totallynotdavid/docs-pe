{#def source #}
{#css UiSources.css #}
<label class="fuente">
  <input class="fuente__control"
         type="checkbox"
         name="sources"
         value="{{ source.id }}"
         {% if source.default %}checked{% endif %}>
  <span class="fuente__contenido">
    <span class="fuente__cabecera">
      <span class="fuente__nombre">{{ source.name }}</span>
      <span class="fuente__aplica">{{ source.eligibility }}</span>
    </span>
    <span class="fuente__resultado">Recibirás: {{ source.output }}</span>
    <span class="fuente__muestra">
      <span class="fuente__muestra-titulo">Así se verá el resultado</span>
      <span class="fuente__tabla">
        <span>{% for header in source.sample_headers %}<b>{{ header }}</b>{% endfor %}</span>
        <span>{% for value in source.sample_row %}<i>{{ value }}</i>{% endfor %}</span>
      </span>
    </span>
  </span>
</label>
