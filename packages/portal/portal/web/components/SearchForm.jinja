{#def action, query="" #}
<form {{ attrs.render(class="search-form", method="get", action=action) }}>
  <label class="field search-form__field" for="search-query">Número de documento</label>
  <input id="search-query"
         class="control"
         name="q"
         value="{{ query }}"
         autocomplete="off"
         placeholder="Ej. 10412345678">
  <ActionButton type="submit">
    <Icon name="search" />
    Buscar
  </ActionButton>
</form>
