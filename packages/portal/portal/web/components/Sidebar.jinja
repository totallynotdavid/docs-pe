{#def usuario, csrf_token="", setup=False #}
<aside class="sidebar">
  <a class="marca" href="/">
    <span class="marca-sello" aria-hidden="true">W</span>
    Worker
  </a>
  {% if not setup %}
    <nav class="navegacion" aria-label="Navegación principal">
      <p class="nav-etiqueta">Espacio de trabajo</p>
      <a class="nav-enlace" href="/">
        <Icono nombre="equipos" />
        Equipos
      </a>
      <a class="nav-enlace" href="/notificaciones">
        <Icono nombre="actividad" />
        Actividad
      </a>
      {% if usuario.is_site_admin %}
        <a class="nav-enlace nav-enlace--admin" href="/administracion/equipos">
          <Icono nombre="administracion" />
          Administración
        </a>
      {% endif %}
    </nav>
  {% endif %}
  <div class="cuenta" data-cuenta>
    <button class="cuenta-activador"
            type="button"
            aria-expanded="false"
            aria-controls="menu-cuenta"
            data-cuenta-activador>
      <span class="avatar">{{ usuario.email[0] }}</span>
      <span>Mi cuenta</span>
      <Icono nombre="abajo" :tamano="14" />
    </button>
    <div class="cuenta-menu" id="menu-cuenta" hidden data-cuenta-menu>
      <span class="cuenta-email">{{ usuario.email }}</span>
      <AccionEnLinea accion="/logout" :csrf_token="csrf_token">
        <button type="submit">
          <Icono nombre="salir" :tamano="14" />
          Cerrar sesión
        </button>
      </AccionEnLinea>
    </div>
  </div>
</aside>
