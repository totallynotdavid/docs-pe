{#def value #}
{% set tones = {
  "queued": "secondary",
  "draft": "secondary",
  "retired": "secondary",
  "offline": "secondary",
  "running": "info",
  "validating": "info",
  "online": "success",
  "active": "success",
  "completed": "success",
  "published": "success",
  "ok": "success",
  "cancelling": "warning",
  "failed": "destructive",
  "cancelled": "destructive"
} %}
<Badge :variant="tones.get(value, 'secondary')"
       :class="'status status--' ~ value">
  <span class="status__dot" aria-hidden="true"></span>
  {{ content }}
</Badge>
