{#def href="", variant="primary", size="md" #}
{% set classes = "button button--" ~ (variant or "primary") ~ " button--" ~ size %}
{% if href %}
  <a {{ attrs.render(class=classes, href=href) }}>{{ content }}</a>
{% else %}
  <button {{ attrs.render(class=classes) }}>{{ content }}</button>
{% endif %}
