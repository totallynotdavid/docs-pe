{#def title, user=None, csrf_token="", setup=False #}
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/tokens.css">
    <link rel="stylesheet" href="{{ component_stylesheet_url }}">
    <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
    <script defer src="/static/htmx.min.js"></script>
    <script defer src="/static/portal.js"></script>
  </head>
  <body{% if not user %} class="signed-out"{% endif %}>
    <a class="skip-link" href="#content">Saltar al contenido</a>
    {% if user %}
      <div class="app-shell">
        <Sidebar :user="user" :csrf_token="csrf_token" :setup="setup" />
        <div class="workspace">{{ content }}</div>
      </div>
    {% else %}
      {{ content }}
    {% endif %}
  </body>
</html>
