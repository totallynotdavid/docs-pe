{#def title, user=None, csrf_token="", setup=False, minimal=False #}
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/tokens.css">
    <link rel="stylesheet" href="{{ component_stylesheet_url }}">
    <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
    <script defer src="/static/htmx.min.js"></script>
    <script defer src="/static/portal.js"></script>
  </head>
  <body class="{{ 'signed-out' if not user else ('onboarding' if setup else '') }}">
    <a class="skip-link" href="#content">Saltar al contenido</a>
    {% if user and setup %}
      {# No nav to show mid-setup: a bare brand and a way out, not a sidebar
         with an empty middle. #}
      <header class="onboarding-topbar">
        <a class="onboarding-topbar__brand" href="/">
          <span class="onboarding-topbar__mark" aria-hidden="true">W</span>
          Worker
        </a>
        <InlineAction action="/logout" :csrf_token="csrf_token">
          <button type="submit">Cerrar sesión</button>
        </InlineAction>
      </header>
      {{ content }}
    {% elif user %}
      <div class="{{ 'app-shell app-shell--minimal' if minimal else 'app-shell' }}">
        <Sidebar :user="user" :csrf_token="csrf_token" :minimal="minimal" />
        <div class="workspace">{{ content }}</div>
      </div>
    {% else %}
      {{ content }}
    {% endif %}
  </body>
</html>
