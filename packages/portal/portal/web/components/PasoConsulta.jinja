{#def numero, titulo, descripcion, titulo_id #}
{#css FlujoConsulta.css #}
<section class="paso-consulta" aria-labelledby="{{ titulo_id }}">
  <div class="paso-consulta__encabezado">
    <span class="paso-consulta__numero">{{ numero }}</span>
    <div>
      <h2 id="{{ titulo_id }}">{{ titulo }}</h2>
      <p>{{ descripcion }}</p>
    </div>
  </div>
  {{ content }}
</section>
