<label class="csv-file" data-csv-dropzone>
  <input class="csv-file__input"
         name="input_file"
         type="file"
         accept=".csv,text/csv"
         required
         data-csv-input>
  <span class="csv-file__icon">
    <Icon name="upload" :size="22" />
  </span>
  <span class="csv-file__title" data-csv-title>Elige un archivo CSV</span>
  <span class="csv-file__help" data-csv-status>o arrástralo aquí · máximo 10 MB</span>
</label>
<p class="csv-file__detection"
   data-csv-detection
   hidden
   aria-live="polite"></p>
