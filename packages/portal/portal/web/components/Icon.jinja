{#def name, size=16 #}
{# Path data is lifted verbatim from the shared icon set (lucide/tabler at a
   24px grid, stroke-width 2) so a glyph here is the same glyph elsewhere in
   the brand. Add a name to this list rather than inlining an svg in a page. #}
<svg class="icon icon--{{ name }}"
     width="{{ size }}"
     height="{{ size }}"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true">
  {% if name == 'users' %}
    <path d="M5 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
    <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
  {% elif name == 'user' %}
    <circle cx="12" cy="8" r="5" />
    <path d="M20 21a8 8 0 0 0-16 0" />
  {% elif name == 'activity' %}
    <path d="M3 12h4l3-9l4 18l3-9h4" />
  {% elif name == 'settings' %}
    <path d="M12 15.5a3.5 3.5 0 1 0 0-7a3.5 3.5 0 0 0 0 7z" />
    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6h.01A1.65 1.65 0 0 0 10 3.09V3a2 2 0 1 1 4 0v.09A1.65 1.65 0 0 0 15 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.01A1.65 1.65 0 0 0 20.91 10H21a2 2 0 1 1 0 4h-.09A1.65 1.65 0 0 0 19.4 15z" />
  {% elif name == 'shield' %}
    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
    <path d="m9 12 2 2 4-4" />
  {% elif name == 'lock' %}
    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
  {% elif name == 'search' %}
    <path d="m21 21-4.34-4.34" />
    <circle cx="11" cy="11" r="8" />
  {% elif name == 'logout' %}
    <path d="M10 12h11" />
    <path d="m17 9 3 3-3 3" />
    <path d="M4 4v16" />
  {% elif name == 'chevron-down' %}
    <path d="m6 9 6 6 6-6" />
  {% elif name == 'chevron-left' %}
    <path d="m15 18-6-6 6-6" />
  {% elif name == 'chevron-right' %}
    <path d="m9 18 6-6-6-6" />
  {% elif name == 'plus' %}
    <path d="M12 5v14" />
    <path d="M5 12h14" />
  {% elif name == 'x' %}
    <path d="M18 6 6 18" />
    <path d="m6 6 12 12" />
  {% elif name == 'check' %}
    <path d="M20 6 9 17l-5-5" />
  {% elif name == 'circle-check' %}
    <path d="M21.801 10A10 10 0 1 1 17 3.335" />
