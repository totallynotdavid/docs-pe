{#def team, query, results, page, has_more #}
{% if query %}
  {% if results %}
    <DataTable>
      <TableHeader>
        <TableRow>
          <TableHead>
            Documento
          </TableHead>
          <TableHead>
            Fuente
          </TableHead>
          <TableHead align="right">
            Estado
          </TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {% for result in results %}
          <TableRow>
            <TableCell ellipsis>
              <a href="/teams/{{ team.id }}/entries/{{ result.id }}">{{ result.document }}</a>
            </TableCell>
            <TableCell>
              <MetaText>
                {{ result.source }}
              </MetaText>
            </TableCell>
            <TableCell align="right">
              <Status :value="result.status">
                {{ result.status|entry_status }}
              </Status>
            </TableCell>
          </TableRow>
        {% endfor %}
      </TableBody>
    </DataTable>
  {% else %}
    <EmptyState icon="search"
                title="Sin resultados"
                :description="'Ningún documento de este equipo coincide con “' ~ query ~ '”.'" />
  {% endif %}
{% else %}
  <EmptyState icon="search"
              title="Busca un documento"
              description="Escribe un DNI o RUC para ver en qué tareas aparece." />
{% endif %}
{% if page > 1 or has_more %}
  <Pagination label="Paginación de búsqueda">
    {% if page > 1 %}
      <a hx-get="/teams/{{ team.id }}/search?q={{ query }}&page={{ page - 1 }}"
         hx-target="#search-results">
        <Icon name="chevron-left" :size="14" />
        Anterior
      </a>
    {% endif %}
    {% if has_more %}
      <a hx-get="/teams/{{ team.id }}/search?q={{ query }}&page={{ page + 1 }}"
         hx-target="#search-results">
        Siguiente
        <Icon name="chevron-right" :size="14" />
      </a>
    {% endif %}
  </Pagination>
{% endif %}
