{#def team, query, results, page, has_more #}
{% if query %}
  {% if results %}
    <List>
      {% for result in results %}
        <ListItem>
          <a href="/teams/{{ team.id }}/jobs/{{ result.job_id }}">{{ result.document }}</a>
          <span>{{ result.filename }}</span>
        </ListItem>
      {% endfor %}
    </List>
  {% else %}
    <EmptyState>
      No hay resultados.
    </EmptyState>
  {% endif %}
{% else %}
  <EmptyState>
    Ingresa un documento para buscar.
  </EmptyState>
{% endif %}
{% if page > 1 or has_more %}
  <Pagination label="Paginación de búsqueda">
    {% if page > 1 %}
      <a hx-get="/teams/{{ team.id }}/search?q={{ query }}&page={{ page - 1 }}"
         hx-target="#search-results">Anterior</a>
    {% endif %}
    {% if has_more %}
      <a hx-get="/teams/{{ team.id }}/search?q={{ query }}&page={{ page + 1 }}"
         hx-target="#search-results">Siguiente</a>
    {% endif %}
  </Pagination>
{% endif %}
