{#def detail="" #}
<Layout title="No disponible">
  <MainContent>
    <AuthCard title="No se pudo continuar"
              description="La acción no está disponible en este momento."
              title_id="problem-title">
      {% if detail %}<Message>{{ detail }}</Message>{% endif %}
      <ActionButton href="/">
        Volver al inicio
      </ActionButton>
    </AuthCard>
  </MainContent>
</Layout>
