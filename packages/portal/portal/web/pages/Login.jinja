{#def user, csrf_token, turnstile_site_key, error #}
<Layout title="Ingresar · Worker" :user="user" :csrf_token="csrf_token">
  <MainContent>
    <AuthCard title="Iniciar sesión"
              description="Accede al portal de Worker."
              title_id="login-title">
      {% if error %}<Message>No se pudo iniciar sesión.</Message>{% endif %}
      <FormLayout action="/login" :csrf_token="csrf_token">
        <Field label="Correo electrónico">
          <input type="email" name="email" autocomplete="email" required>
        </Field>
        <Field label="Contraseña">
          <input type="password"
                 name="password"
                 autocomplete="current-password"
                 required>
        </Field>
        {% if turnstile_site_key %}
          <div class="cf-turnstile"
               data-sitekey="{{ turnstile_site_key }}"
               data-response-field-name="turnstile_token"></div>
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                  async
                  defer></script>
        {% endif %}
        <button type="submit">Ingresar</button>
      </FormLayout>
    </AuthCard>
  </MainContent>
</Layout>
