{#def user, csrf_token, team, entries #}
<Layout :title="'Actividad de búsqueda · ' ~ team.name ~ ' · Worker'"
        :user="user"
        :csrf_token="csrf_token">
  <TopBar title="Actividad de búsqueda">
    <ActionButton variant="secondary" :href="'/teams/' ~ team.id ~ '/settings'">
      Configuración
    </ActionButton>
  </TopBar>
  <MainContent>
    <h1 class="sr-only">Actividad de búsqueda de {{ team.name }}</h1>
    <Panel>
      <PanelHeader title="Búsquedas recientes"
                   description="Quién buscó qué y cuántos resultados encontró." />
      <List>
        {% for entry in entries %}
          <ListItem>
            <div>
              <span>{{ entry.query }}</span>
              <MetaText>
                {{ entry.actor_email }} · {{ entry.created_at.strftime("%d/%m %H:%M") }}
              </MetaText>
            </div>
            <MetaText>
              {{ entry.result_count }} resultado{{ 's' if entry.result_count != 1 else '' }}
            </MetaText>
          </ListItem>
        {% else %}
          <ListItem class="empty-state">
            Aún no se han hecho búsquedas en este equipo.
          </ListItem>
        {% endfor %}
      </List>
    </Panel>
  </MainContent>
</Layout>
