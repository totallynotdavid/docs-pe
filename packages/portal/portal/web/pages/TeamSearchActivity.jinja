{#def user, csrf_token, team, entries #}
<Layout :title="'Actividad de búsqueda · ' ~ team.name"
        :user="user"
        :csrf_token="csrf_token"
        active="team-settings"
        :active_team="team">
  <TopBar title="Actividad de búsqueda" />
  <MainContent>
    <h1 class="sr-only">Actividad de búsqueda de {{ team.name }}</h1>
    <Panel>
      <PanelHeader title="Búsquedas recientes"
                   description="Quién buscó qué y cuántos resultados encontró." />
      {% if entries %}
        <List>
          {% for entry in entries %}
            <ListItem>
              <Stack>
                <span>{{ entry.query }}</span>
                <MetaText>
                  {{ entry.actor_email }} · {{ entry.created_at.strftime("%d/%m %H:%M") }}
                </MetaText>
              </Stack>
              <MetaText>
                {{ entry.result_count }} resultado{{ 's' if entry.result_count != 1 else '' }}
              </MetaText>
            </ListItem>
          {% endfor %}
        </List>
      {% else %}
        <EmptyState icon="search"
                    title="Sin búsquedas todavía"
                    description="Cuando alguien del equipo busque un documento, quedará registrado aquí." />
      {% endif %}
    </Panel>
  </MainContent>
</Layout>
