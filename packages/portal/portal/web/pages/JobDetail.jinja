{#def user, csrf_token, team, job #}
<Layout :title="job.filename"
        :user="user"
        :csrf_token="csrf_token"
        active="team-jobs"
        :active_team="team">
  <TopBar :title="job.filename">
    {% if team.role.value == 'team_leader' and not is_terminal(job) %}
      <Submission :action="'/teams/' ~ team.id ~ '/jobs/' ~ job.id ~ '/cancel'"
                  :csrf_token="csrf_token">
        <ActionButton variant="destructive" size="sm" type="submit">
          <Icon name="x" :size="14" />
          Cancelar consulta
        </ActionButton>
      </Submission>
    {% endif %}
  </TopBar>
  <MainContent>
    <h1 class="sr-only">Tarea {{ job.filename }}</h1>
    <Panel>
      <PanelBody>
        <div id="job-progress"
             aria-live="polite"
             aria-atomic="true"
             {% if not is_terminal(job) %} data-sse-url="/teams/{{ team.id }}/jobs/{{ job.id }}/progress" {% endif %}>
          <JobProgress :job="job" />
        </div>
      </PanelBody>
    </Panel>
  </MainContent>
</Layout>
