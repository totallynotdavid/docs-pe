{#def user, csrf_token, team, job #}
<Layout :titulo="job.filename ~ ' · Worker'"
        :usuario="user"
        :csrf_token="csrf_token">
  <BarraSuperior :titulo="job.filename">
    {% if team.role.value == 'team_leader' and not es_terminal(job) %}
      <Envio :accion="'/equipos/' ~ team.id ~ '/procesos/' ~ job.id ~ '/cancelar'"
             :csrf_token="csrf_token">
        <Boton variante="peligro" type="submit">
          Cancelar consulta
        </Boton>
      </Envio>
    {% endif %}
  </BarraSuperior>
  <Contenido>
    <h1 class="solo-lector">Tarea {{ job.filename }}</h1>
    <Panel>
      <PanelCuerpo>
        <div id="progreso-proceso"
             aria-live="polite"
             aria-atomic="true"
             {% if not es_terminal(job) %} hx-ext="sse" sse-connect="/equipos/{{ team.id }}/procesos/{{ job.id }}/progreso" sse-swap="progreso" sse-close="fin" {% endif %}>
          <JobProgressFragment :job="job" />
        </div>
      </PanelCuerpo>
    </Panel>
  </Contenido>
</Layout>
