{#def user, csrf_token, team, members, invites, error #}
<Layout :title="'Personas · ' ~ team.name"
        :user="user"
        :csrf_token="csrf_token"
        active="team-settings-members"
        :active_team="team">
  <TopBar title="Personas"
          icon="users"
          :breadcrumb="[{'label': 'Equipos', 'href': '/'}, {'label': team.name, 'href': '/teams/' ~ team.id}]">
    <ActionButton type="submit" form="invite-form" size="sm">
      Enviar invitación
    </ActionButton>
  </TopBar>
  <MainContent>
    <Panel>
      <PanelHeader title="Invitar a una persona"
                   description="Si todavía no tiene cuenta, le enviamos un enlace para crearla." />
      <PanelBody>
        {% if error %}<Message>{{ error }}</Message>{% endif %}
        <FormLayout id="invite-form"
                    :action="'/teams/' ~ team.id ~ '/settings/members'"
                    :csrf_token="csrf_token">
          <Field label="Correo electrónico">
            <input type="email" name="email" required autofocus>
          </Field>
          <Field label="Nivel de acceso">
            <select name="role">
              <option value="team_member">Puede consultar</option>
              <option value="team_leader">Puede administrar</option>
            </select>
          </Field>
        </FormLayout>
      </PanelBody>
    </Panel>
    <Panel>
      <PanelHeader title="Equipo actual"
                   description="Las personas administradoras pueden actualizar la configuración." />
      <DataTable>
        <TableHeader>
          <TableRow>
            <TableHead>
              Persona
            </TableHead>
            <TableHead>
              Acceso
            </TableHead>
            <TableHead align="right">
              Acciones
            </TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {% for member, role in members %}
            <TableRow>
              <TableCell ellipsis>
                {{ member.email }}
              </TableCell>
              <TableCell>
                <MetaText>
                  {{ role|role_name }}
                </MetaText>
              </TableCell>
              <TableCell align="right">
                {% if member.id != user.id %}
                  <InlineAction :action="'/teams/' ~ team.id ~ '/settings/members/remove'"
                                :csrf_token="csrf_token">
                    <input type="hidden" name="email" value="{{ member.email }}">
                    <ActionButton variant="link-danger" type="submit">
                      Quitar
                    </ActionButton>
                  </InlineAction>
                {% endif %}
              </TableCell>
            </TableRow>
          {% endfor %}
        </TableBody>
      </DataTable>
    </Panel>
    {% if invites %}
      <Panel>
        <PanelHeader title="Invitaciones pendientes" />
        <DataTable>
          <TableHeader>
            <TableRow>
              <TableHead>
                Correo
              </TableHead>
              <TableHead>
                Acceso
              </TableHead>
              <TableHead align="right">
                Acciones
              </TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {% for invite in invites %}
              <TableRow>
                <TableCell ellipsis>
                  {{ invite.email }}
                </TableCell>
                <TableCell>
                  <MetaText>
                    {{ invite.role|role_name }}
                  </MetaText>
                </TableCell>
                <TableCell align="right">
                  <Actions>
                    <InlineAction :action="'/teams/' ~ team.id ~ '/settings/invites/' ~ invite.id ~ '/resend'"
                                  :csrf_token="csrf_token">
                      <ActionButton variant="link" type="submit">
                        Reenviar
                      </ActionButton>
                    </InlineAction>
                    <InlineAction :action="'/teams/' ~ team.id ~ '/settings/invites/' ~ invite.id ~ '/cancel'"
                                  :csrf_token="csrf_token">
                      <ActionButton variant="link-danger" type="submit">
                        Cancelar
                      </ActionButton>
                    </InlineAction>
                  </Actions>
                </TableCell>
              </TableRow>
            {% endfor %}
          </TableBody>
        </DataTable>
      </Panel>
    {% endif %}
  </MainContent>
</Layout>
