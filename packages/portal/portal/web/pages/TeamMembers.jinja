{#def user, csrf_token, team, members, candidates, error #}
<Layout :titulo="'Personas · ' ~ team.name ~ ' · Worker'"
        :usuario="user"
        :csrf_token="csrf_token">
  <BarraSuperior titulo="Personas del equipo" />
  <Contenido>
    <h1 class="solo-lector">Personas de {{ team.name }}</h1>
    <Panel>
      <PanelCabecera titulo="Añadir persona"
                     descripcion="Las personas deben tener una cuenta creada en la plataforma." />
      <PanelCuerpo>
        {% if error %}<Mensaje>{{ error }}</Mensaje>{% endif %}
        <Formulario :accion="'/equipos/' ~ team.id ~ '/ajustes/miembros'"
                    :csrf_token="csrf_token">
          <Campo etiqueta="Persona">
            <select name="email" required>
              <option value="" selected disabled>Selecciona una persona</option>
              {% for candidate in candidates %}<option value="{{ candidate.email }}">{{ candidate.email }}</option>{% endfor %}
            </select>
          </Campo>
          <Campo etiqueta="Nivel de acceso">
            <select name="role">
              <option value="team_member">Puede consultar</option>
              <option value="team_leader">Puede administrar</option>
            </select>
          </Campo>
          <button type="submit">Guardar acceso</button>
        </Formulario>
      </PanelCuerpo>
    </Panel>
    <Panel>
      <PanelCabecera titulo="Equipo actual"
                     descripcion="Las personas administradoras pueden actualizar la configuración." />
      <Lista>
        {% for member, role in members %}
          <ListaItem>
            <span>{{ member.email }}</span>
            <Acciones>
              <MetaDato>
                {{ role|rol }}
              </MetaDato>
              {% if member.id != user.id %}
                <AccionEnLinea :accion="'/equipos/' ~ team.id ~ '/ajustes/miembros/quitar'"
                               :csrf_token="csrf_token">
                  <input type="hidden" name="email" value="{{ member.email }}">
                  <button type="submit">Quitar</button>
                </AccionEnLinea>
              {% endif %}
            </Acciones>
          </ListaItem>
        {% endfor %}
      </Lista>
    </Panel>
  </Contenido>
</Layout>
