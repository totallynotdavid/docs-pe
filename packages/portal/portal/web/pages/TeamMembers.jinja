{#def user, csrf_token, team, members, candidates, error #}
<Layout :title="'Personas · ' ~ team.name ~ ' · Worker'"
        :user="user"
        :csrf_token="csrf_token">
  <TopBar title="Personas del equipo" />
  <MainContent>
    <h1 class="sr-only">Personas de {{ team.name }}</h1>
    <Panel>
      <PanelHeader title="Añadir persona"
                   description="Las personas deben tener una cuenta creada en la plataforma." />
      <PanelBody>
        {% if error %}<Message>{{ error }}</Message>{% endif %}
        <FormLayout :action="'/teams/' ~ team.id ~ '/settings/members'"
                    :csrf_token="csrf_token">
          <Field label="Persona">
            <select name="email" required>
              <option value="" selected disabled>Selecciona una persona</option>
              {% for candidate in candidates %}<option value="{{ candidate.email }}">{{ candidate.email }}</option>{% endfor %}
            </select>
          </Field>
          <Field label="Nivel de acceso">
            <select name="role">
              <option value="team_member">Puede consultar</option>
              <option value="team_leader">Puede administrar</option>
            </select>
          </Field>
          <button type="submit">Guardar acceso</button>
        </FormLayout>
      </PanelBody>
    </Panel>
    <Panel>
      <PanelHeader title="Equipo actual"
                   description="Las personas administradoras pueden actualizar la configuración." />
      <List>
        {% for member, role in members %}
          <ListItem>
            <span>{{ member.email }}</span>
            <Actions>
              <MetaText>
                {{ role|role_name }}
              </MetaText>
              {% if member.id != user.id %}
                <InlineAction :action="'/teams/' ~ team.id ~ '/settings/members/remove'"
                              :csrf_token="csrf_token">
                  <input type="hidden" name="email" value="{{ member.email }}">
                  <button type="submit">Quitar</button>
                </InlineAction>
              {% endif %}
            </Actions>
          </ListItem>
        {% endfor %}
      </List>
    </Panel>
  </MainContent>
</Layout>
