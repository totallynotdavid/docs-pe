{#def user, csrf_token, team, members, invites, error #}
<Layout :title="'Personas · ' ~ team.name"
        :user="user"
        :csrf_token="csrf_token"
        active="team-settings"
        :active_team="team">
  <TopBar title="Personas del equipo" />
  <MainContent>
    <h1 class="sr-only">Personas de {{ team.name }}</h1>
    <Panel>
      <PanelHeader title="Invitar a una persona"
                   description="Si todavía no tiene cuenta, le enviamos un enlace para crearla." />
      <PanelBody>
        {% if error %}<Message>{{ error }}</Message>{% endif %}
        <FormLayout :action="'/teams/' ~ team.id ~ '/settings/members'"
                    :csrf_token="csrf_token">
          <Field label="Correo electrónico">
            <input type="email" name="email" required autofocus>
          </Field>
          <Field label="Nivel de acceso">
            <select name="role">
              <option value="team_member">Puede consultar</option>
              <option value="team_leader">Puede administrar</option>
            </select>
          </Field>
          <button type="submit">Enviar invitación</button>
        </FormLayout>
      </PanelBody>
    </Panel>
    <Panel>
      <PanelHeader title="Equipo actual"
                   description="Las personas administradoras pueden actualizar la configuración." />
      <List>
        {% for member, role in members %}
          <ListItem>
            <span>{{ member.email }}</span>
            <Actions>
              <MetaText>
                {{ role|role_name }}
              </MetaText>
              {% if member.id != user.id %}
                <InlineAction :action="'/teams/' ~ team.id ~ '/settings/members/remove'"
                              :csrf_token="csrf_token">
                  <input type="hidden" name="email" value="{{ member.email }}">
                  <button type="submit">Quitar</button>
                </InlineAction>
              {% endif %}
            </Actions>
          </ListItem>
        {% endfor %}
      </List>
    </Panel>
    {% if invites %}
      <Panel>
        <PanelHeader title="Invitaciones pendientes" />
        <List>
          {% for invite in invites %}
            <ListItem>
              <div>
                <span>{{ invite.email }}</span>
                <MetaText>
                  {{ invite.role|role_name }}
                </MetaText>
              </div>
              <Actions>
                <InlineAction :action="'/teams/' ~ team.id ~ '/settings/invites/' ~ invite.id ~ '/resend'"
                              :csrf_token="csrf_token">
                  <button type="submit">Reenviar</button>
                </InlineAction>
                <InlineAction :action="'/teams/' ~ team.id ~ '/settings/invites/' ~ invite.id ~ '/cancel'"
                              :csrf_token="csrf_token">
                  <button type="submit">Cancelar</button>
                </InlineAction>
              </Actions>
            </ListItem>
          {% endfor %}
        </List>
      </Panel>
    {% endif %}
  </MainContent>
</Layout>
