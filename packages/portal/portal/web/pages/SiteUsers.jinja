{#def user, csrf_token, users, error #}
<Layout title="Personas · Administración · Worker"
        :user="user"
        :csrf_token="csrf_token">
  <TopBar title="Administración · Personas">
    <ActionButton variant="secondary" href="/admin/teams">
      Equipos
    </ActionButton>
    <ActionButton variant="secondary" href="/admin/search-activity">
      Búsquedas
    </ActionButton>
    <ActionButton variant="secondary" href="/admin/system">
      Sistema
    </ActionButton>
  </TopBar>
  <MainContent>
    <h1 class="sr-only">Administración de personas</h1>
    <Panel>
      <PanelHeader title="Añadir persona"
                   description="La contraseña se cambia en el primer acceso si corresponde." />
      <PanelBody>
        {% if error %}<Message>{{ error }}</Message>{% endif %}
        <FormLayout action="/admin/users" :csrf_token="csrf_token">
          <Field label="Correo electrónico">
            <input type="email" name="email" required>
          </Field>
          <Field label="Contraseña temporal">
            <input type="password" name="password" minlength="12" required>
          </Field>
          <button type="submit">Añadir persona</button>
        </FormLayout>
      </PanelBody>
    </Panel>
    <Panel>
      <PanelHeader title="Personas con acceso" />
      <List>
        {% for person in users %}
          <ListItem>
            <a href="/admin/users/{{ person.id }}">{{ person.email }}</a>
            <MetaText>
              {% if not person.is_active %}
                Desactivada
              {% elif person.is_site_admin %}
                Administradora de la plataforma
              {% else %}
                Activa
              {% endif %}
            </MetaText>
          </ListItem>
        {% endfor %}
      </List>
    </Panel>
  </MainContent>
</Layout>
