{#def user, csrf_token, error, setup #}
<Layout title="Crear equipo · Worker"
        :user="user"
        :csrf_token="csrf_token"
        :setup="setup">
  <TopBar title="Crear equipo" />
  <MainContent>
    <h1 class="sr-only">Crear equipo</h1>
    <Panel>
      <PanelBody>
        {% if error %}<Message>{{ error }}</Message>{% endif %}
        <FormLayout action="/setup" :csrf_token="csrf_token">
          <Field label="Nombre del equipo">
            <input name="name"
                   maxlength="120"
                   required
                   autofocus
                   placeholder="Ej. Equipo Lima">
          </Field>
          <Field label="Dirección del equipo"
                 help_text="Se usa para identificar el equipo en su enlace. Solo minúsculas, números y guiones.">
            <input name="slug"
                   pattern="[a-z0-9][a-z0-9-]{1,62}"
                   required
                   placeholder="equipo-lima">
          </Field>
          <button type="submit">Crear equipo</button>
        </FormLayout>
      </PanelBody>
    </Panel>
  </MainContent>
</Layout>
