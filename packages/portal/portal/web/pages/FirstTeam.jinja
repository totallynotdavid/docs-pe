{#def user, csrf_token, error, setup #}
<Layout title="Crear equipo · Worker"
        :user="user"
        :csrf_token="csrf_token"
        :setup="setup">
  <MainContent>
    <h1>Crea tu primer equipo</h1>
    <p class="subtitle">
      Así organizas el trabajo: quién sube documentos, qué conexión usa y quién ve los resultados. Puedes invitar a más personas después.
    </p>
    <Panel>
      <PanelBody>
        {% if error %}<Message>{{ error }}</Message>{% endif %}
        <FormLayout action="/setup" :csrf_token="csrf_token">
          <Field label="Nombre del equipo">
            <input name="name"
                   maxlength="120"
                   required
                   autofocus
                   placeholder="Ej. Equipo Lima">
          </Field>
          <button type="submit">Crear equipo</button>
        </FormLayout>
      </PanelBody>
    </Panel>
  </MainContent>
</Layout>
