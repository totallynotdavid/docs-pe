{#def user, csrf_token, error, setup #}
<Layout title="Crear equipo"
        :user="user"
        :csrf_token="csrf_token"
        :setup="setup"
        :onboarding_step="2">
  <MainContent>
    <PageIntro title="Crea tu primer equipo"
               description="Así organizas el trabajo: quién sube documentos, qué conexión usa y quién ve los resultados. Puedes invitar a más personas después." />
    <Panel>
      <PanelBody>
        {% if error %}<Message>{{ error }}</Message>{% endif %}
        <FormLayout action="/setup" :csrf_token="csrf_token">
          <Field label="Nombre del equipo">
            <input name="name"
                   maxlength="120"
                   required
                   autofocus
                   placeholder="Ej. Equipo Lima">
          </Field>
          <ActionButton type="submit">
            Crear equipo
          </ActionButton>
        </FormLayout>
      </PanelBody>
    </Panel>
  </MainContent>
</Layout>
