{#def user, csrf_token, error, setup #}
<Layout title="Crear equipo · Worker"
        :user="user"
        :csrf_token="csrf_token"
        :setup="setup">
  <UiTopBar title="Crear equipo" />
  <UiContent>
    <h1 class="solo-lector">Crear equipo</h1>
    <UiPanel>
      <UiPanelBody>
        {% if error %}<UiMessage>{{ error }}</UiMessage>{% endif %}
        <UiForm action="/inicio" :csrf_token="csrf_token">
          <UiField label="Nombre del equipo">
            <input name="name"
                   maxlength="120"
                   required
                   autofocus
                   placeholder="Ej. Equipo Lima">
          </UiField>
          <UiField label="Dirección del equipo"
                   help_text="Se usa para identificar el equipo en su enlace. Solo minúsculas, números y guiones.">
            <input name="slug"
                   pattern="[a-z0-9][a-z0-9-]{1,62}"
                   required
                   placeholder="equipo-lima">
          </UiField>
          <button type="submit">Crear equipo</button>
        </UiForm>
      </UiPanelBody>
    </UiPanel>
  </UiContent>
</Layout>
