{#def user, csrf_token, users, teams, error, show_form #}
<Layout title="Administración"
        :user="user"
        :csrf_token="csrf_token"
        active="admin-teams">
  <TopBar title="Administración · Equipos" icon="users">
    {% if not show_form %}
      <ActionButton href="/admin/teams?add=1">
        Crear equipo
      </ActionButton>
    {% endif %}
  </TopBar>
  <MainContent>
    <h1 class="sr-only">Administración de equipos</h1>
    <Panel>
      <PanelHeader title="Equipos existentes" />
      {% if teams %}
        <DataTable>
          <TableHeader>
            <TableRow>
              <TableHead>
                Equipo
              </TableHead>
              <TableHead>
                Identificador
              </TableHead>
              <TableHead align="right">
                Acciones
              </TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {% for team in teams %}
              <TableRow>
                <TableCell ellipsis>
                  <a href="/teams/{{ team.id }}">{{ team.name }}</a>
                </TableCell>
                <TableCell ellipsis>
                  <MetaText>
                    {{ team.slug }}
                  </MetaText>
                </TableCell>
                <TableCell align="right">
                  <ActionButton variant="secondary"
                                size="sm"
                                :href="'/teams/' ~ team.id ~ '/settings/proxy'">
                    Gestionar
                  </ActionButton>
                </TableCell>
              </TableRow>
            {% endfor %}
          </TableBody>
        </DataTable>
      {% else %}
        <EmptyState icon="users"
                    title="Aún no hay equipos"
                    description="Crea el primero y asígnale una persona responsable.">
          <ActionButton href="/admin/teams?add=1">
            <Icon name="plus" />
            Crear equipo
          </ActionButton>
        </EmptyState>
      {% endif %}
    </Panel>
    {% if show_form %}
      <Panel>
        <PanelHeader title="Crear equipo"
                     description="Asigna una persona responsable desde el inicio." />
        <PanelBody>
          {% if error %}<Message>{{ error }}</Message>{% endif %}
          <FormLayout action="/admin/teams" :csrf_token="csrf_token">
            <Field label="Nombre">
              <input name="name"
                     maxlength="120"
                     required
                     autofocus
                     placeholder="Ej. Equipo Lima">
            </Field>
            <Field label="Persona responsable">
              <select name="leader_email" required>
                <option value="" selected disabled>Selecciona una persona</option>
                {% for person in users %}<option value="{{ person.email }}">{{ person.email }}</option>{% endfor %}
              </select>
            </Field>
            <ActionButton type="submit">
              Crear equipo
            </ActionButton>
          </FormLayout>
        </PanelBody>
      </Panel>
    {% endif %}
  </MainContent>
</Layout>
