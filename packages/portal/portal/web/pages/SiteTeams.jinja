{#def user, csrf_token, users, teams, error, show_form #}
<Layout title="Administración"
        :user="user"
        :csrf_token="csrf_token"
        active="admin-teams">
  <TopBar title="Equipos"
          icon="users"
          :breadcrumb="[{'label': 'Administración', 'href': '/admin'}]">
    {% if not show_form %}
      <ActionButton href="/admin/teams?add=1" size="sm">
        Crear equipo
      </ActionButton>
    {% endif %}
  </TopBar>
  <MainContent>
    <Panel>
      <PanelHeader title="Equipos existentes" />
      {% if teams %}
        <DataTable>
          <TableHeader>
            <TableRow>
              <TableHead>
                Equipo
              </TableHead>
              <TableHead>
                Identificador
              </TableHead>
              <TableHead align="right">
                Acciones
              </TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {% for team in teams %}
              <TableRow>
                <TableCell ellipsis>
                  <a href="/teams/{{ team.id }}">{{ team.name }}</a>
                </TableCell>
                <TableCell ellipsis>
                  <MetaText>
                    {{ team.slug }}
                  </MetaText>
                </TableCell>
                <TableCell align="right">
                  <Actions>
                    <ActionButton variant="secondary" size="sm" :href="'/teams/' ~ team.id">
                      Gestionar
                    </ActionButton>
                    <Submission :action="'/admin/teams/' ~ team.id ~ '/global-search'"
                                :csrf_token="csrf_token">
                      <input type="hidden"
                             name="enabled"
                             value="{{ 'false' if team.has_global_search else 'true' }}">
                      <ActionButton type="submit" variant="ghost" size="sm">
                        {{ 'Quitar búsqueda global' if team.has_global_search else 'Dar búsqueda global' }}
                      </ActionButton>
                    </Submission>
                  </Actions>
                </TableCell>
              </TableRow>
            {% endfor %}
          </TableBody>
        </DataTable>
      {% else %}
        <EmptyState icon="users"
                    title="Aún no hay equipos"
                    description="Crea el primero y asígnale una persona responsable.">
          <ActionButton href="/admin/teams?add=1">
            <Icon name="plus" />
            Crear equipo
          </ActionButton>
        </EmptyState>
      {% endif %}
    </Panel>
    {% if show_form %}
      <Panel>
        <PanelHeader title="Crear equipo"
                     description="Asigna una persona responsable desde el inicio." />
        <PanelBody>
          {% if error %}<Message>{{ error }}</Message>{% endif %}
          <FormLayout action="/admin/teams" :csrf_token="csrf_token">
            <Field label="Nombre">
              <input name="name"
                     maxlength="120"
                     required
                     autofocus
                     placeholder="Ej. Equipo Lima">
            </Field>
            <Field label="Persona responsable">
              <select name="leader_email" required>
                <option value="" selected disabled>Selecciona una persona</option>
                {% for person in users %}<option value="{{ person.email }}">{{ person.email }}</option>{% endfor %}
              </select>
            </Field>
            <ActionButton type="submit">
              Crear equipo
            </ActionButton>
          </FormLayout>
        </PanelBody>
      </Panel>
    {% endif %}
  </MainContent>
</Layout>
