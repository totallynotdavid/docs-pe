{#def user, csrf_token, users, teams, error #}
<Layout title="Administración · Worker" :user="user" :csrf_token="csrf_token">
  <UiTopBar title="Administración · Equipos">
    <UiButton variant="secundario" href="/administracion/usuarios">
      Personas
    </UiButton>
  </UiTopBar>
  <UiContent>
    <h1 class="solo-lector">Administración de equipos</h1>
    <UiPanel>
      <UiPanelHeader title="Crear equipo"
                     description="Asigna una persona responsable desde el inicio." />
      <UiPanelBody>
        {% if error %}<UiMessage>{{ error }}</UiMessage>{% endif %}
        <UiForm action="/administracion/equipos" :csrf_token="csrf_token">
          <UiField label="Nombre">
            <input name="name" maxlength="120" required placeholder="Ej. Equipo Lima">
          </UiField>
          <UiField label="Dirección del equipo"
                   help_text="Solo minúsculas, números y guiones.">
            <input name="slug"
                   pattern="[a-z0-9][a-z0-9-]{1,62}"
                   required
                   placeholder="equipo-lima">
          </UiField>
          <UiField label="Persona responsable">
            <select name="leader_email" required>
              <option value="" selected disabled>Selecciona una persona</option>
              {% for person in users %}<option value="{{ person.email }}">{{ person.email }}</option>{% endfor %}
            </select>
          </UiField>
          <button type="submit">Crear equipo</button>
        </UiForm>
      </UiPanelBody>
    </UiPanel>
    <UiPanel>
      <UiPanelHeader title="Equipos existentes" />
      <UiList>
        {% for team in teams %}
          <UiListItem>
            <span>{{ team.name }}</span>
            <UiMeta>
              {{ team.slug }}
            </UiMeta>
          </UiListItem>
        {% else %}
          <UiListItem class="estado-vacio">
            Aún no hay equipos.
          </UiListItem>
        {% endfor %}
      </UiList>
    </UiPanel>
  </UiContent>
</Layout>
