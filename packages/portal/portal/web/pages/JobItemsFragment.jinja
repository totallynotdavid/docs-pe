{#def team, job_id, items, total_items, page #}
{% if items %}
  <DataTable>
    <TableHeader>
      <TableRow>
        <TableHead>
          Documento
        </TableHead>
        <TableHead>
          Fuente
        </TableHead>
        <TableHead align="right">
          Estado
        </TableHead>
      </TableRow>
    </TableHeader>
    <TableBody>
      {% for item in items %}
        <TableRow>
          <TableCell ellipsis>
            {% if item.entry_id %}
              <a href="/teams/{{ team.id }}/entries/{{ item.entry_id }}">{{ item.document }}</a>
            {% else %}
              {{ item.document }}
            {% endif %}
          </TableCell>
          <TableCell>
            <MetaText>
              {{ item.source }}
            </MetaText>
          </TableCell>
          <TableCell align="right">
            <Status :value="item.state">
              {{ item.state|item_state }}
            </Status>
          </TableCell>
        </TableRow>
      {% endfor %}
    </TableBody>
  </DataTable>
{% else %}
  <EmptyState icon="list"
              title="Sin documentos todavía"
              description="Esta tarea no tiene documentos que mostrar." />
{% endif %}
{% if page > 1 or page * 20 < total_items %}
  <Pagination label="Paginación de resultados">
    {% if page > 1 %}
      <a hx-get="/teams/{{ team.id }}/jobs/{{ job_id }}/items?page={{ page - 1 }}"
         hx-target="#job-items">
        <Icon name="chevron-left" :size="14" />
        Anterior
      </a>
    {% endif %}
    {% if page * 20 < total_items %}
      <a hx-get="/teams/{{ team.id }}/jobs/{{ job_id }}/items?page={{ page + 1 }}"
         hx-target="#job-items">
        Siguiente
        <Icon name="chevron-right" :size="14" />
      </a>
    {% endif %}
  </Pagination>
{% endif %}
