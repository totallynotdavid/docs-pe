{#def user, error #}
{# No CSRF token: there is no session yet to synchronize one against. The
   pending-login cookie is SameSite=Strict and single-use, and the handler
   carries the same-origin guard, so a cross-site post cannot reach this
   form's state. #}
<Layout title="Verificación · Worker" :user="user" csrf_token="">
  <MainContent>
    <AuthCard title="Verificación en dos pasos"
              description="Ingresa el código de tu aplicación de autenticación."
              title_id="mfa-title">
      {% if error %}<Message>El código no es válido.</Message>{% endif %}
      <form action="/login/mfa" method="post" class="form">
        <Field label="Código"
               help_text="También puedes usar uno de tus códigos de recuperación.">
          <input type="text"
                 name="code"
                 inputmode="numeric"
                 autocomplete="one-time-code"
                 autofocus
                 required>
        </Field>
        <button type="submit">Verificar</button>
      </form>
      <button type="button" class="button--secondary" data-passkey-login>Usar una clave de acceso</button>
      <p data-passkey-status class="help-text" role="status"></p>
    </AuthCard>
  </MainContent>
</Layout>
