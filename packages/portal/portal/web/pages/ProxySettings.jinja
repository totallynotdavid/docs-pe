{#def user, csrf_token, team, connections, readiness, provider, providers, fields, show_form, error #}
<Layout :title="'Conexión proxy · ' ~ team.name"
        :user="user"
        :csrf_token="csrf_token"
        active="team-settings"
        :active_team="team">
  <TopBar title="Conexión proxy">
    {% if connections and not show_form %}
      <ActionButton :href="'/teams/' ~ team.id ~ '/settings/proxy?add=1'">
        Añadir conexión
      </ActionButton>
    {% endif %}
  </TopBar>
  <MainContent>
    <h1 class="sr-only">Conexión proxy de {{ team.name }}</h1>
    {% if error %}<Message>{{ error }}</Message>{% endif %}
    {% if connections %}
      <Panel>
        <PanelHeader title="Conexiones"
                     :description="'Hay una conexión validada y lista para usar.' if readiness.has_active_credential else 'Aún falta una conexión activa.'" />
        <List>
          {% for connection in connections %}
            <ListItem>
              <InlineAction :action="'/teams/' ~ team.id ~ '/settings/proxy/' ~ connection.credential_id ~ '/rename'"
                            :csrf_token="csrf_token">
                <input name="label" value="{{ connection.label }}" maxlength="120" required>
                <button type="submit">Guardar</button>
              </InlineAction>
              <MetaText>
                {{ provider_label(connection.provider) }} · {{ connection.state.value|credential_state }}
              </MetaText>
            </ListItem>
          {% endfor %}
        </List>
      </Panel>
    {% endif %}
    {% if show_form %}
      <Panel>
        <PanelHeader title="Nueva conexión"
                     description="Añade los datos de tu proveedor para continuar." />
        <PanelBody>
          <Actions position="above">
            {% for name in providers %}
              <ActionButton :variant="'' if provider == name else 'secondary'"
                            :href="'/teams/' ~ team.id ~ '/settings/proxy?add=1&provider=' ~ name">
                {{ provider_label(name) }}
              </ActionButton>
            {% endfor %}
          </Actions>
          <FormLayout :action="'/teams/' ~ team.id ~ '/settings/proxy'"
                      :csrf_token="csrf_token"
                      autocomplete="off">
            <input type="hidden" name="provider" value="{{ provider }}">
            <Field label="Nombre de referencia">
              <input name="label"
                     maxlength="120"
                     placeholder="Ej. Producción Lima"
                     required>
            </Field>
            {% for field in fields %}
              <Field :label="field_label(field.name)">
                {% if field.choices %}
                  <select name="{{ field.name }}" {% if field.required %}required{% endif %}>
                    {% for value in field.choices %}
                      <option value="{{ value }}"
                              {% if value is eq field.default %}selected{% endif %}>{{ choice_label(value) }}</option>
                    {% endfor %}
                  </select>
                {% else %}
                  <input name="{{ field.name }}"
                         type="{% if field.secret %}password{% else %}text{% endif %}"
                         value="{% if not field.secret %}{{ field.default }}{% endif %}"
                         {% if field.required %}required{% endif %}>
                {% endif %}
              </Field>
            {% endfor %}
            <button type="submit">Validar y guardar</button>
          </FormLayout>
        </PanelBody>
      </Panel>
    {% endif %}
  </MainContent>
</Layout>
