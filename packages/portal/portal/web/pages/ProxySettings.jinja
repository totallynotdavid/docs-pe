{#def user, csrf_token, team, readiness, provider, fields, credentials, error #}
<Layout :titulo="'Conexión proxy · ' ~ team.name ~ ' · Worker'"
        :usuario="user"
        :csrf_token="csrf_token">
  <BarraSuperior titulo="Conexión proxy" />
  <Contenido>
    <h1 class="solo-lector">Conexión proxy de {{ team.name }}</h1>
    <Panel>
      <PanelCabecera :titulo="'Conexión activa' if readiness.has_active_credential else 'Configurar conexión'"
                     :descripcion="'Hay una conexión validada y lista para usar.' if readiness.has_active_credential else 'Añade los datos de tu proveedor para continuar.'" />
      <PanelCuerpo>
        <Acciones posicion="encima">
          <Boton :variante="'' if provider.value == 'geonode' else 'secundario'"
                 :href="'/equipos/' ~ team.id ~ '/ajustes/proxy?proveedor=geonode'">
            GeoNode
          </Boton>
          <Boton :variante="'' if provider.value == 'dataimpulse' else 'secundario'"
                 :href="'/equipos/' ~ team.id ~ '/ajustes/proxy?proveedor=dataimpulse'">
            DataImpulse
          </Boton>
        </Acciones>
        {% if error %}<Mensaje>{{ error }}</Mensaje>{% endif %}
        <Formulario :accion="'/equipos/' ~ team.id ~ '/ajustes/proxy'"
                    :csrf_token="csrf_token"
                    autocomplete="off">
          <input type="hidden" name="provider" value="{{ provider.value }}">
          <Campo etiqueta="Nombre de referencia">
            <input name="label"
                   maxlength="120"
                   placeholder="Ej. Producción Lima"
                   required>
          </Campo>
          {% for field in fields %}
            <Campo :etiqueta="field.label">
              {% if field.choices %}
                <select name="{{ field.name }}" {% if field.required %}required{% endif %}>
                  {% for value, choice_label in field.choices %}
                    <option value="{{ value }}"
                            {% if value is eq field.default %}selected{% endif %}>{{ choice_label }}</option>
                  {% endfor %}
                </select>
              {% else %}
                <input name="{{ field.name }}"
                       type="{% if field.secret %}password{% else %}text{% endif %}"
                       value="{% if not field.secret %}{{ field.default }}{% endif %}"
                       {% if field.required %}required{% endif %}>
              {% endif %}
            </Campo>
          {% endfor %}
          <button type="submit">Validar y guardar</button>
        </Formulario>
      </PanelCuerpo>
    </Panel>
    <Panel>
      <PanelCabecera titulo="Historial de conexiones"
                     descripcion="Versiones guardadas para este equipo." />
      <Lista>
        {% for credential in credentials %}
          <ListaItem>
            <span>{{ credential.label }} · versión {{ credential.version }}</span>
            <MetaDato>
              {{ credential.state.value|estado_credencial }}
            </MetaDato>
          </ListaItem>
        {% else %}
          <ListaItem class="estado-vacio">
            Aún no hay conexiones guardadas.
          </ListaItem>
        {% endfor %}
      </Lista>
    </Panel>
  </Contenido>
</Layout>
