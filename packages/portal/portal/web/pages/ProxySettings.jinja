{#def user, csrf_token, team, readiness, provider, providers, fields, credentials, error #}
<Layout :title="'Conexión proxy · ' ~ team.name ~ ' · Worker'"
        :user="user"
        :csrf_token="csrf_token">
  <UiTopBar title="Conexión proxy" />
  <UiContent>
    <h1 class="solo-lector">Conexión proxy de {{ team.name }}</h1>
    <UiPanel>
      <UiPanelHeader :title="'Conexión activa' if readiness.has_active_credential else 'Configurar conexión'"
                     :description="'Hay una conexión validada y lista para usar.' if readiness.has_active_credential else 'Añade los datos de tu proveedor para continuar.'" />
      <UiPanelBody>
        <UiActions position="encima">
          {% for name in providers %}
            <UiButton :variant="'' if provider == name else 'secundario'"
                      :href="'/equipos/' ~ team.id ~ '/ajustes/proxy?proveedor=' ~ name">
              {{ provider_label(name) }}
            </UiButton>
          {% endfor %}
        </UiActions>
        {% if error %}<UiMessage>{{ error }}</UiMessage>{% endif %}
        <UiForm :action="'/equipos/' ~ team.id ~ '/ajustes/proxy'"
                :csrf_token="csrf_token"
                autocomplete="off">
          <input type="hidden" name="provider" value="{{ provider }}">
          <UiField label="Nombre de referencia">
            <input name="label"
                   maxlength="120"
                   placeholder="Ej. Producción Lima"
                   required>
          </UiField>
          {% for field in fields %}
            <UiField :label="field_label(field.name)">
              {% if field.choices %}
                <select name="{{ field.name }}" {% if field.required %}required{% endif %}>
                  {% for value in field.choices %}
                    <option value="{{ value }}"
                            {% if value is eq field.default %}selected{% endif %}>{{ choice_label(value) }}</option>
                  {% endfor %}
                </select>
              {% else %}
                <input name="{{ field.name }}"
                       type="{% if field.secret %}password{% else %}text{% endif %}"
                       value="{% if not field.secret %}{{ field.default }}{% endif %}"
                       {% if field.required %}required{% endif %}>
              {% endif %}
            </UiField>
          {% endfor %}
          <button type="submit">Validar y guardar</button>
        </UiForm>
      </UiPanelBody>
    </UiPanel>
    <UiPanel>
      <UiPanelHeader title="Historial de conexiones"
                     description="Versiones guardadas para este equipo." />
      <UiList>
        {% for credential in credentials %}
          <UiListItem>
            <span>{{ credential.label }} · versión {{ credential.version }}</span>
            <UiMeta>
              {{ credential.state.value|credential_state }}
            </UiMeta>
          </UiListItem>
        {% else %}
          <UiListItem class="estado-vacio">
            Aún no hay conexiones guardadas.
          </UiListItem>
        {% endfor %}
      </UiList>
    </UiPanel>
  </UiContent>
</Layout>
