{#def team, jobs, page, total #}
{% if jobs %}
  <DataTable>
    <TableHeader>
      <TableRow>
        <TableHead>
          Archivo
        </TableHead>
        <TableHead align="right">
          Estado
        </TableHead>
      </TableRow>
    </TableHeader>
    <TableBody>
      {% for job in jobs %}
        <TableRow>
          <TableCell ellipsis>
            <a href="/teams/{{ team.id }}/jobs/{{ job.id }}">{{ job.filename }}</a>
          </TableCell>
          <TableCell align="right">
            <Status :value="job.state">
              {{ job.state|job_state }}
            </Status>
          </TableCell>
        </TableRow>
      {% endfor %}
    </TableBody>
  </DataTable>
{% else %}
  <EmptyState icon="list"
              title="No hay tareas todavía"
              description="Sube un CSV para lanzar la primera consulta del equipo." />
{% endif %}
{% if page > 1 or page * 20 < total %}
  <Pagination label="Paginación de tareas">
    {% if page > 1 %}
      <a hx-get="/teams/{{ team.id }}?page={{ page - 1 }}"
         hx-target="#jobs-list">
        <Icon name="chevron-left" :size="14" />
        Anterior
      </a>
    {% endif %}
    {% if page * 20 < total %}
      <a hx-get="/teams/{{ team.id }}?page={{ page + 1 }}"
         hx-target="#jobs-list">
        Siguiente
        <Icon name="chevron-right" :size="14" />
      </a>
    {% endif %}
  </Pagination>
{% endif %}
