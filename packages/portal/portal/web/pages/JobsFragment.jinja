{#def team, jobs, page, total #}
{% if jobs %}
  <List>
    {% for job in jobs %}
      <ListItem>
        <a href="/teams/{{ team.id }}/jobs/{{ job.id }}">{{ job.filename }}</a>
        <span>{{ job.state|job_state }}</span>
      </ListItem>
    {% endfor %}
  </List>
{% else %}
  <EmptyState>
    No hay tareas todavía.
  </EmptyState>
{% endif %}
{% if page > 1 or page * 20 < total %}
  <Pagination label="Paginación de tareas">
    {% if page > 1 %}
      <a hx-get="/teams/{{ team.id }}?page={{ page - 1 }}"
         hx-target="#jobs-list">Anterior</a>
    {% endif %}
    {% if page * 20 < total %}
      <a hx-get="/teams/{{ team.id }}?page={{ page + 1 }}"
         hx-target="#jobs-list">Siguiente</a>
    {% endif %}
  </Pagination>
{% endif %}
