{#def user, csrf_token, team, readiness #}
<Layout :title="'Configuración · ' ~ team.name ~ ' · Worker'"
        :user="user"
        :csrf_token="csrf_token">
  <TopBar title="Configuración del equipo" />
  <MainContent>
    <h1 class="sr-only">Configuración del equipo</h1>
    <Panel>
      <List>
        <ListItem>
          <div>
            <a href="/teams/{{ team.id }}/settings/proxy">Conexión proxy</a>
            <MetaText>
              {% if readiness.has_active_credential %}
                Configurada y lista para usar.
              {% else %}
                Aún falta configurar una conexión.
              {% endif %}
            </MetaText>
          </div>
          <ActionButton variant="secondary" :href="'/teams/' ~ team.id ~ '/settings/proxy'">
            Gestionar
          </ActionButton>
        </ListItem>
        <ListItem>
          <div>
            <a href="/teams/{{ team.id }}/settings/members">Personas del equipo</a>
            <MetaText>
              Añade o actualiza los permisos de acceso.
            </MetaText>
          </div>
          <ActionButton variant="secondary" :href="'/teams/' ~ team.id ~ '/settings/members'">
            Gestionar
          </ActionButton>
        </ListItem>
      </List>
    </Panel>
  </MainContent>
</Layout>
