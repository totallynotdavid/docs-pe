{#def user, csrf_token, team, credentials, source_options, error #}
<Layout :title="'Nueva consulta · ' ~ team.name ~ ' · Worker'"
        :user="user"
        :csrf_token="csrf_token">
  <UiTopBar title="Nueva consulta" />
  <UiContent>
    <UiQueryFlow title="Nueva consulta"
                 description="Sube una lista y elige la información que necesitas.">
      {% if error %}<UiMessage>{{ error }}</UiMessage>{% endif %}
      {% if credentials %}
        <UiForm :action="'/equipos/' ~ team.id ~ '/procesos'"
                :csrf_token="csrf_token"
                css_class="formulario-consulta"
                enctype="multipart/form-data">
          <UiQueryStep number="1"
                       title="Sube tu archivo"
                       description="CSV con un documento en la primera columna de cada fila."
                       title_id="archivo-titulo">
            <UiCsvFile />
          </UiQueryStep>
          <UiQueryStep number="2"
                       title="¿Qué quieres obtener?"
                       description="Puedes elegir más de un resultado."
                       title_id="fuentes-titulo">
            <UiSources>
              {% for source in source_options %}<UiSource :source="source" />{% endfor %}
            </UiSources>
          </UiQueryStep>
          <UiQueryAction>
            <div>
              {% if credentials|length == 1 %}
                <input type="hidden"
                       name="credential_version_id"
                       value="{{ credentials[0].id }}">
                {# Breaking this run would collapse to a space before the period. #}
                {# djlint:off #}
                <p class="consulta-accion__conexion">Usarás la conexión <strong>{{ credentials[0].label }}</strong>.</p>
                {# djlint:on #}
              {% else %}
                <label class="consulta-accion__selector">
                  Conexión
                  <select name="credential_version_id" required>
                    {% for credential in credentials %}<option value="{{ credential.id }}">{{ credential.label }}</option>{% endfor %}
                  </select>
                </label>
              {% endif %}
            </div>
            <button type="submit">Iniciar consulta</button>
          </UiQueryAction>
        </UiForm>
      {% else %}
        <UiPanel>
          <UiPanelBody>
            <h2>Configura una conexión para comenzar</h2>
            <p class="subtitulo">Este equipo necesita una conexión proxy activa para ejecutar consultas.</p>
            <UiActions position="debajo">
              <UiButton :href="'/equipos/' ~ team.id ~ '/ajustes/proxy'">
                Configurar conexión
              </UiButton>
            </UiActions>
          </UiPanelBody>
        </UiPanel>
      {% endif %}
    </UiQueryFlow>
  </UiContent>
</Layout>
