{#def user, csrf_token, team, credentials, source_options, error, max_upload_mb, max_upload_bytes #}
<Layout :title="'Nueva consulta · ' ~ team.name"
        :user="user"
        :csrf_token="csrf_token"
        active="team-jobs"
        :active_team="team">
  <TopBar title="Nueva consulta" icon="plus" />
  <MainContent>
    <QueryFlow title="Nueva consulta"
               description="Sube una lista y elige la información que necesitas.">
      {% if error %}<Message>{{ error }}</Message>{% endif %}
      {% if credentials %}
        <FormLayout :action="'/teams/' ~ team.id ~ '/jobs'"
                    :csrf_token="csrf_token"
                    css_class="query-form"
                    enctype="multipart/form-data">
          <QueryStep number="1"
                     title="Sube tu archivo"
                     description="CSV con un documento en la primera columna de cada fila."
                     title_id="upload-step-title">
            <CsvFile :max_mb="max_upload_mb" :max_bytes="max_upload_bytes" />
          </QueryStep>
          <QueryStep number="2"
                     title="¿Qué quieres obtener?"
                     description="Puedes elegir más de un resultado."
                     title_id="sources-step-title">
            <Sources>
              {% for source in source_options %}<SourceOption :source="source" />{% endfor %}
            </Sources>
          </QueryStep>
          <QueryAction>
            <div>
              {% if credentials|length == 1 %}
                <input type="hidden"
                       name="credential_version_id"
                       value="{{ credentials[0].id }}">
                {# Breaking this run would collapse to a space before the period. #}
                {# djlint:off #}
                <p class="query-action__connection">Usarás la conexión <strong>{{ credentials[0].label }}</strong>.</p>
                {# djlint:on #}
              {% else %}
                <label class="query-action__select">
                  Conexión
                  <select class="control" name="credential_version_id" required>
                    {% for credential in credentials %}<option value="{{ credential.id }}">{{ credential.label }}</option>{% endfor %}
                  </select>
                </label>
              {% endif %}
            </div>
            <ActionButton type="submit">
              Iniciar consulta
            </ActionButton>
          </QueryAction>
        </FormLayout>
      {% else %}
        <Panel>
          <EmptyState icon="link"
                      title="Configura una conexión para comenzar"
                      description="Este equipo necesita una conexión proxy activa para ejecutar consultas.">
            <ActionButton :href="'/teams/' ~ team.id ~ '/settings/proxy'">
              Configurar conexión
            </ActionButton>
          </EmptyState>
        </Panel>
      {% endif %}
    </QueryFlow>
  </MainContent>
</Layout>
