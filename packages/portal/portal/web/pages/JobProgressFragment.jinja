{#def job #}
<UiStatus :value="job.state">
  {{ job.state|job_state }}
</UiStatus>
<p>{{ job_summary(job) }}</p>
<UiMetrics>
  <UiMetric label="Registros">
    {{ job.items|length }}
  </UiMetric>
  <UiMetric label="Excluidos">
    {{ job.exclusions|length }}
  </UiMetric>
  <UiMetric label="Publicados">
    {{ job.items|selectattr('state.value', 'equalto', 'published') |list|length }}
  </UiMetric>
</UiMetrics>
{% if job.exclusions %}
  <h2>Excluidos</h2>
  <UiPlainList>
    {% for exclusion in job.exclusions %}
      <li>Línea {{ exclusion.ordinal }}: {{ exclusion.value }} ({{ exclusion.reason }})</li>
    {% endfor %}
  </UiPlainList>
{% endif %}
