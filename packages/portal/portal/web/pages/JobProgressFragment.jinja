{#def job #}
<Status :value="job.state">
  {{ job.state|job_state }}
</Status>
<p>{{ job_summary(job) }}</p>
<Metrics>
  <Metric label="Registros">
    {{ job.items|length }}
  </Metric>
  <Metric label="Excluidos">
    {{ job.exclusions|length }}
  </Metric>
  <Metric label="Publicados">
    {{ job.items|selectattr('state.value', 'equalto', 'published') |list|length }}
  </Metric>
</Metrics>
{% if job.exclusions %}
  <h2>Excluidos</h2>
  <List variant="plain">
    {% for exclusion in job.exclusions %}
      <li>Línea {{ exclusion.ordinal }}: {{ exclusion.value }} ({{ exclusion.reason|exclusion_reason }})</li>
    {% endfor %}
  </List>
{% endif %}
