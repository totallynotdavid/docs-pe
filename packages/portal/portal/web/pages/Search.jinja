{#def user, csrf_token, team, query, results, page, has_more, minimal=False #}
<Layout :title="'Buscar · ' ~ team.name"
        :user="user"
        :csrf_token="csrf_token"
        :minimal="minimal"
        active="team-search"
        :active_team="team">
  <TopBar title="Buscar documentos" />
  <MainContent>
    <h1 class="sr-only">Buscar documentos en {{ team.name }}</h1>
    <Panel>
      <PanelBody>
        <SearchForm :action="'/teams/' ~ team.id ~ '/search'"
                    :query="query"
                    hx-get="/teams/{{ team.id }}/search"
                    hx-target="#search-results"
                    hx-push-url="true" />
      </PanelBody>
      <div id="search-results">
        <SearchResultsFragment :team="team"
                               :query="query"
                               :results="results"
                               :page="page"
                               :has_more="has_more" />
      </div>
    </Panel>
  </MainContent>
</Layout>
