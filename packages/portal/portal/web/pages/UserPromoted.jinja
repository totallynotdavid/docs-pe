{#def user, csrf_token, person, enrollment #}
<Layout :title="'Administración habilitada · Worker'"
        :user="user"
        :csrf_token="csrf_token">
  <TopBar title="Administración habilitada" />
  <MainContent>
    <h1 class="sr-only">Administración habilitada para {{ person.email }}</h1>
    <Panel>
      <PanelHeader :title="person.email ~ ' ahora es administradora del sitio'"
                   description="Comparte lo siguiente con esta persona por un canal seguro. No podremos volver a mostrarlo." />
      <PanelBody>
        <Message>
          Guarda esto ahora. Esta página no se puede volver a abrir.
        </Message>
        <Field label="Código de configuración del autenticador">
          <input type="text" readonly value="{{ enrollment.enrollment_uri }}">
        </Field>
        <Field label="Códigos de recuperación"
               help_text="Cada código sirve una sola vez si se pierde el autenticador.">
          <List variant="plain">
            {% for code in enrollment.recovery_codes %}
              <ListItem>
                <code>
                  {{ code }}
                </code>
              </ListItem>
            {% endfor %}
          </List>
        </Field>
        <Actions position="below">
          <ActionButton :href="'/admin/users/' ~ person.id">
            Continuar
          </ActionButton>
        </Actions>
      </PanelBody>
    </Panel>
  </MainContent>
</Layout>
