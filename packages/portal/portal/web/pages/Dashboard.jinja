{#def user, csrf_token, teams, minimal=False #}
<Layout title="Equipos"
        :user="user"
        :csrf_token="csrf_token"
        :minimal="minimal"
        active="teams">
  <TopBar title="Equipos" icon="users" />
  <MainContent>
    <h1 class="sr-only">Equipos</h1>
    <Panel aria-labelledby="teams-title">
      <PanelHeader title="Tus equipos"
                   :description="'Elige un equipo para buscar.' if minimal else 'Espacios a los que tienes acceso.'"
                   title_id="teams-title" />
      {% if teams %}
        <DataTable>
          <TableHeader>
            <TableRow>
              <TableHead>
                Equipo
              </TableHead>
              {% if not minimal %}<TableHead align="right">Acceso</TableHead>{% endif %}
            </TableRow>
          </TableHeader>
          <TableBody>
            {% for team in teams %}
              <TableRow>
                <TableCell ellipsis>
                  <a href="/teams/{{ team.id }}{{ '/search' if minimal else '' }}">{{ team.name }}</a>
                </TableCell>
                {% if not minimal %}
                  <TableCell align="right">
                    <MetaText>
                      {{ team.role|role_name }}
                    </MetaText>
                  </TableCell>
                {% endif %}
              </TableRow>
            {% endfor %}
          </TableBody>
        </DataTable>
      {% else %}
        <EmptyState icon="users"
                    title="Aún no perteneces a un equipo"
                    description="Cuando alguien te agregue a uno, aparecerá aquí." />
      {% endif %}
    </Panel>
  </MainContent>
</Layout>
