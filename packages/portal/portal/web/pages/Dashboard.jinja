{#def user, csrf_token, teams, minimal=False #}
<Layout title="Equipos"
        :user="user"
        :csrf_token="csrf_token"
        :minimal="minimal"
        active="teams">
  <TopBar title="Equipos" />
  <MainContent>
    <h1 class="sr-only">Equipos</h1>
    <Panel aria-labelledby="teams-title">
      <PanelHeader title="Tus equipos"
                   :description="'Elige un equipo para buscar.' if minimal else 'Espacios a los que tienes acceso.'"
                   title_id="teams-title" />
      {% if teams %}
        <List>
          {% for team in teams %}
            <ListItem>
              <a href="/teams/{{ team.id }}{{ '/search' if minimal else '' }}">{{ team.name }}</a>
              {% if not minimal %}
                <MetaText>
                  {{ team.role|role_name }}
                </MetaText>
              {% endif %}
            </ListItem>
          {% endfor %}
        </List>
      {% else %}
        <EmptyState>
          Aún no perteneces a un equipo.
        </EmptyState>
      {% endif %}
    </Panel>
  </MainContent>
</Layout>
