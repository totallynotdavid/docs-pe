{#def user, csrf_token, teams #}
<Layout title="Equipos · Worker" :user="user" :csrf_token="csrf_token">
  <TopBar title="Equipos" />
  <MainContent>
    <h1 class="sr-only">Equipos</h1>
    <Panel aria-labelledby="teams-title">
      <PanelHeader title="Tus equipos"
                   description="Espacios a los que tienes acceso."
                   title_id="teams-title" />
      {% if teams %}
        <List>
          {% for team in teams %}
            <ListItem>
              <a href="/teams/{{ team.id }}">{{ team.name }}</a>
              <MetaText>
                {{ team.role|role_name }}
              </MetaText>
            </ListItem>
          {% endfor %}
        </List>
      {% else %}
        <EmptyState>
          Aún no perteneces a un equipo.
        </EmptyState>
      {% endif %}
    </Panel>
  </MainContent>
</Layout>
