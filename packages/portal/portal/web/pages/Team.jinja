{#def user, csrf_token, team, jobs, page, total, minimal=False, readiness=None #}
<Layout :title="team.name"
        :user="user"
        :csrf_token="csrf_token"
        :minimal="minimal"
        active="team-jobs"
        :active_team="team">
  <TopBar :title="team.name">
    {% if team.role and team.role.value == 'team_leader' %}
      <ActionButton :href="'/teams/' ~ team.id ~ '/jobs/new'">
        Nueva consulta
      </ActionButton>
    {% endif %}
  </TopBar>
  <MainContent>
    <h1 class="sr-only">{{ team.name }}</h1>
    {% if readiness and not (readiness.has_active_credential and readiness.has_members_beyond_creator) %}
      <Panel>
        <PanelHeader title="Antes de empezar"
                     description="Dos pasos para que el equipo esté listo." />
        <List>
          <ListItem>
            <span class="{{ 'checklist-item--done' if readiness.has_active_credential }}">Conecta un proxy</span>
            {% if not readiness.has_active_credential %}
              <ActionButton variant="secondary" :href="'/teams/' ~ team.id ~ '/settings/proxy'">
                Conectar
              </ActionButton>
            {% endif %}
          </ListItem>
          <ListItem>
            <span class="{{ 'checklist-item--done' if readiness.has_members_beyond_creator }}">Invita a tu equipo</span>
            {% if not readiness.has_members_beyond_creator %}
              <ActionButton variant="secondary" :href="'/teams/' ~ team.id ~ '/settings/members'">
                Invitar
              </ActionButton>
            {% endif %}
          </ListItem>
        </List>
      </Panel>
    {% endif %}
    {% if (team.role and team.role.value == 'team_leader') or user.is_site_admin %}
      <Panel aria-labelledby="jobs-title">
        <PanelHeader title="Tareas recientes"
                     description="El estado se actualiza mientras se procesan."
                     title_id="jobs-title" />
        <div id="jobs-list">
          <JobsFragment :team="team" :jobs="jobs" :page="page" :total="total" />
        </div>
      </Panel>
    {% else %}
      <Panel>
        <EmptyState>
          Puedes buscar documentos en este equipo.
        </EmptyState>
      </Panel>
    {% endif %}
  </MainContent>
</Layout>
