{#def user, csrf_token, team, jobs, page, total #}
<Layout :titulo="team.name ~ ' · Worker'"
        :usuario="user"
        :csrf_token="csrf_token">
  <BarraSuperior :titulo="team.name">
    <Boton variante="secundario" :href="'/equipos/' ~ team.id ~ '/buscar'">
      Buscar
    </Boton>
    {% if team.role.value == 'team_leader' %}
      <Boton :href="'/equipos/' ~ team.id ~ '/procesos/nuevo'">
        Nueva consulta
      </Boton>
    {% endif %}
  </BarraSuperior>
  <Contenido>
    <h1 class="solo-lector">{{ team.name }}</h1>
    {% if team.role.value == 'team_leader' %}
      <Panel aria-labelledby="titulo-tareas">
        <PanelCabecera titulo="Tareas recientes"
                       descripcion="El estado se actualiza mientras se procesan."
                       titulo_id="titulo-tareas">
          <Boton variante="secundario" :href="'/equipos/' ~ team.id ~ '/ajustes'">
            Configuración
          </Boton>
        </PanelCabecera>
        <div id="lista-procesos"
             hx-get="/equipos/{{ team.id }}?page=1"
             hx-trigger="load"
             hx-swap="innerHTML">
          <JobsFragment :team="team" :jobs="jobs" :page="page" :total="total" />
        </div>
      </Panel>
    {% else %}
      <Panel>
        <EstadoVacio>
          Puedes buscar documentos en este equipo.
        </EstadoVacio>
      </Panel>
    {% endif %}
  </Contenido>
</Layout>
