{#def user, csrf_token, team, jobs, page, total #}
<Layout :title="team.name ~ ' · Worker'"
        :user="user"
        :csrf_token="csrf_token">
  <TopBar :title="team.name">
    <ActionButton variant="secondary" :href="'/teams/' ~ team.id ~ '/search'">
      Buscar
    </ActionButton>
    {% if team.role.value == 'team_leader' %}
      <ActionButton :href="'/teams/' ~ team.id ~ '/jobs/new'">
        Nueva consulta
      </ActionButton>
    {% endif %}
  </TopBar>
  <MainContent>
    <h1 class="sr-only">{{ team.name }}</h1>
    {% if team.role.value == 'team_leader' %}
      <Panel aria-labelledby="jobs-title">
        <PanelHeader title="Tareas recientes"
                     description="El estado se actualiza mientras se procesan."
                     title_id="jobs-title">
          <ActionButton variant="secondary" :href="'/teams/' ~ team.id ~ '/settings'">
            Configuración
          </ActionButton>
        </PanelHeader>
        <div id="jobs-list">
          <JobsFragment :team="team" :jobs="jobs" :page="page" :total="total" />
        </div>
      </Panel>
    {% else %}
      <Panel>
        <EmptyState>
          Puedes buscar documentos en este equipo.
        </EmptyState>
      </Panel>
    {% endif %}
  </MainContent>
</Layout>
