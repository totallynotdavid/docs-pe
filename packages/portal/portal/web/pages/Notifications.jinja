{#def user, csrf_token, notifications #}
<Layout title="Actividad · Worker" :user="user" :csrf_token="csrf_token">
  <UiTopBar title="Actividad" />
  <UiContent>
    <h1 class="solo-lector">Actividad</h1>
    <UiPanel>
      <UiPanelHeader title="Actualizaciones"
                     description="Se muestran las novedades más recientes." />
      <div id="lista-notificaciones"
           hx-get="/notificaciones"
           hx-trigger="load"
           hx-swap="innerHTML">
        <NotificationsFragment :notifications="notifications" />
      </div>
    </UiPanel>
  </UiContent>
</Layout>
