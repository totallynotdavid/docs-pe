{#def user, csrf_token, notifications #}
<Layout titulo="Actividad · Worker" :usuario="user" :csrf_token="csrf_token">
  <BarraSuperior titulo="Actividad" />
  <Contenido>
    <h1 class="solo-lector">Actividad</h1>
    <Panel>
      <PanelCabecera titulo="Actualizaciones"
                     descripcion="Se muestran las novedades más recientes." />
      <div id="lista-notificaciones"
           hx-get="/notificaciones"
           hx-trigger="load"
           hx-swap="innerHTML">
        <NotificationsFragment :notifications="notifications" />
      </div>
    </Panel>
  </Contenido>
</Layout>
