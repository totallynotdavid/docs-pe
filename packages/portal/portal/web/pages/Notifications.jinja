{#def user, csrf_token, notifications #}
<Layout title="Actividad · Worker" :user="user" :csrf_token="csrf_token">
  <TopBar title="Actividad" />
  <MainContent>
    <h1 class="sr-only">Actividad</h1>
    <Panel>
      <PanelHeader title="Actualizaciones"
                   description="Se muestran las novedades más recientes." />
      <div id="notifications-list">
        <NotificationsFragment :notifications="notifications" />
      </div>
    </Panel>
  </MainContent>
</Layout>
