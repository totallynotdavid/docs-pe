{#def user, csrf_token, next_path, error #}
<Layout title="Confirmar identidad" :user="user" :csrf_token="csrf_token">
  <MainContent>
    <AuthCard title="Confirma tu identidad"
              description="Esta acción necesita un código reciente de tu aplicación de autenticación."
              title_id="stepup-title">
      {% if error %}<Message>El código no es válido.</Message>{% endif %}
      <FormLayout action="/step-up" :csrf_token="csrf_token">
        <input type="hidden" name="next_path" value="{{ next_path }}">
        <Field label="Código"
               help_text="También puedes usar uno de tus códigos de recuperación.">
          <input type="text"
                 name="code"
                 inputmode="numeric"
                 autocomplete="one-time-code"
                 autofocus
                 required>
        </Field>
        <button type="submit">Confirmar</button>
      </FormLayout>
    </AuthCard>
  </MainContent>
</Layout>
