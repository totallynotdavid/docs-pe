{#def notifications #}
{% if notifications %}
  <List>
    {% for notification in notifications %}
      <NotificationRow :notification="notification" />
    {% endfor %}
  </List>
{% else %}
  <EmptyState icon="activity"
              title="No hay notificaciones"
              description="Aquí verás cuándo termina cada tarea de tus equipos." />
{% endif %}
