# Web control plane. These values are deployment configuration; do not commit a
# populated .env file.
JOBS_ENV=development  # production requires JOBS_COOKIE_SECURE=true
JOBS_SESSION_SECRET=
JOBS_SECRET_ENCRYPTION_KEY=
JOBS_DATABASE_PATH=var/jobs.sqlite3
JOBS_OBJECT_ROOT=var/objects
JOBS_ACTIVE_JOB_LIMIT=5
JOBS_COOKIE_SECURE=false  # true behind HTTPS in production

# The first site administrator is created at startup only when both values exist.
# There is no default account and no web bootstrap password form.
JOBS_BOOTSTRAP_ADMIN_EMAIL=
JOBS_BOOTSTRAP_ADMIN_PASSWORD=

# Gives outbound workers permission to register. Supply it through a real secret
# manager in production. Never place proxy credentials in worker CLI arguments.
JOBS_WORKER_BOOTSTRAP_TOKEN=

# External delivery is deliberately disabled unless explicitly enabled and the
# delivery deployment has its corresponding provider configuration.
JOBS_EMAIL_ENABLED=false
JOBS_KAPSO_WHATSAPP_ENABLED=false
JOBS_EMAIL_DSN=
JOBS_KAPSO_API_KEY=
JOBS_ALLOW_LIVE_LOOKUPS=false
